{{ toolbar }}

<div class="comparanator-container">

  <div class="comparanator-layer">
    {{ reference }}
  </div>

  <div class="comparanator-layer">
    {{ current }}
  </div>

  <div class="comparanator-slider">
    <input
      id="comparanator-slider"
      type="range"
      min="0"
      max="100"
      value="50"
      step="1"
    />
  </div>

</div>
