<?php

/**
 * @file
 * Update hooks for Comparenator.
 */

/**
 * Adds on-demand capture settings without overriding existing configuration.
 */
function comparenator_update_11001() {
  $config = \Drupal::configFactory()->getEditable('comparenator.settings');
  foreach (['current_site_url' => '', 'node_binary' => 'node'] as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
    }
  }
  $config->save();
}
