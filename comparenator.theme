<?php

/**
 * @file
 * Theme hook implementations for the Comparenator module.
 */

/**
 * Implements hook_theme().
 */
function comparenator_theme($existing, $type, $theme, $path) {
  return [

    // Toolbar (mode + size selectors).
    'comparenator_toolbar' => [
      'variables' => [
        'modes' => [],
        'sizes' => [],
      ],
      'template' => 'comparenator-toolbar',
    ],

    // Onion-skin view.
    'comparenator_onion' => [
      'variables' => [
        'reference' => NULL,
        'current' => NULL,
        'toolbar' => NULL,
      ],
      'template' => 'comparenator-onion',
    ],

    // Side-by-side view.
    'comparenator_side_by_side' => [
      'variables' => [
        'reference' => NULL,
        'current' => NULL,
        'toolbar' => NULL,
      ],
      'template' => 'comparenator-side-by-side',
    ],

    // Pixel diff view.
    'comparenator_diff' => [
      'variables' => [
        'diff' => NULL,
        'toolbar' => NULL,
      ],
      'template' => 'comparenator-diff',
    ],

    // Missing screenshot fallback.
    'comparenator_missing' => [
      'variables' => [
        'toolbar' => NULL,
        'message' => '',
      ],
      'template' => 'comparenator-missing',
    ],

  ];
}
