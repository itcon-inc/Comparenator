<?php

/**
 * @file
 * Hooks and integrations for the Comparenator module.
 */

/**
 * Implements hook_help().
 */
function comparenator_help($route_name, \Drupal\Core\Routing\RouteMatchInterface $route_match) {
  if ($route_name === 'help.page.comparenator') {
    return '<p>' . t('Comparenator uses local Playwright and Chromium to capture missing screenshots. Configure both environment URLs and viewport sizes, then use the Comparenator link at the top of any page. Unchanged local captures are reused; Refresh screenshots recaptures both environments. Captures are anonymous and publicly stored: never capture confidential content. See the module README for installation instructions.') . '</p>';
  }
}

/**
 * Implements hook_theme().
 */
function comparenator_theme($existing, $type, $theme, $path) {
  return [
    'comparenator_toolbar' => [
      'variables' => ['modes' => [], 'sizes' => [], 'refresh' => NULL],
    ],
    'comparenator_onion' => [
      'variables' => ['reference' => NULL, 'current' => NULL, 'toolbar' => NULL],
    ],
    'comparenator_side_by_side' => [
      'variables' => ['reference' => NULL, 'current' => NULL, 'toolbar' => NULL],
    ],
    'comparenator_diff' => [
      'variables' => ['diff' => NULL, 'toolbar' => NULL],
    ],
    'comparenator_missing' => [
      'variables' => ['toolbar' => NULL, 'message' => ''],
    ],
  ];
}

/**
 * Implements hook_page_top().
 */
function comparenator_page_top(array &$page_top) {
  $page_top['comparenator'] = \Drupal::service('comparenator.page_link')->build();
}

/**
 * Implements hook_cron().
 */
function comparenator_cron() {
  \Drupal::service('comparenator.screenshot_manager')->purgeOldScreenshots();
}

